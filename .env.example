
# Groq API key for LLM investigation
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL password
POSTGRES_PASSWORD=replace_with_a_strong_password

# Apache Airflow encryption key
FERNET_KEY=replace_with_a_generated_fernet_key

# Airflow user ID
AIRFLOW_UID=50000

# Airflow API authentication secret
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_secure_random_secret

# Airflow initial admin account (optional overrides)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace_with_a_strong_admin_password
